# HTTP bind. Keep the default so only this machine can open the dashboard.
HOST=127.0.0.1
PORT=8787

# Base URL of the BDK bot, with no path and no trailing slash.
# Alerts POST to $BOT_ALIAS/v1/channels/observability/alert
# Snapshots POST to $BOT_ALIAS/v1/channels/observability/metrics
BOT_ALIAS=

# Sent as the X-Agent-Alias-Token header when non-empty.
AGENT_ALIAS_TOKEN=

# Optional HMAC. When set, outbound JSON is signed and sent as
# `<DATACAT_HMAC_HEADER>: sha256=<hex>` (HMAC-SHA256 of the raw body).
DATACAT_WEBHOOK_SECRET=
DATACAT_HMAC_HEADER=X-Datacat-Signature

# Periodic metric snapshots for a bot that cannot reach this laptop.
# The dashboard toggle overrides the enabled flag at runtime.
METRICS_PUSH_ENABLED=false
METRICS_PUSH_INTERVAL_MS=15000

# Synthetic prod generator.
GENERATOR_INTERVAL_MS=5000
HISTORY_HOURS=24
