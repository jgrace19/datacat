# HTTP bind. Keep the default so only this machine can open the dashboard.
HOST=127.0.0.1
PORT=8787

# Base URL of the BDK bot, with no path and no trailing slash.
# Alerts POST to $BOT_ALIAS/v1/channels/observability/alert
# Snapshots POST to $BOT_ALIAS/v1/channels/observability/metrics
BOT_ALIAS=

# Sent as the X-Agent-Alias-Token header when non-empty.
AGENT_ALIAS_TOKEN=

# Shared secret the deployed bot checks (for example jgrace19/spike-detector).
# Sent as X-Observability-Token on both /alert and /metrics. Leave empty to omit it.
OBSERVABILITY_SHARED_SECRET=

# HMAC is off by default. Leave DATACAT_WEBHOOK_SECRET empty.
# Hosted bots reject X-BDK-Session-Key when the body is also HMAC-signed.
# Set the secret only for a receiver that expects `<DATACAT_HMAC_HEADER>: sha256=<hex>`.
DATACAT_WEBHOOK_SECRET=
DATACAT_HMAC_HEADER=X-Datacat-Signature

# Periodic metric snapshots for a bot that cannot reach this laptop.
# The dashboard toggle overrides the enabled flag at runtime.
METRICS_PUSH_ENABLED=false
METRICS_PUSH_INTERVAL_MS=15000

# Synthetic prod generator.
GENERATOR_INTERVAL_MS=5000
HISTORY_HOURS=24

# Ship watcher. Polls open pull requests and restarts the marketplace backend.
# npm run dev starts it. Set SHIP_WATCH_ENABLED=false to leave the checkout alone.
SHIP_WATCH_ENABLED=true
SHIP_WATCH_INTERVAL_MS=5000
SHIP_REPO=jgrace19/marketplace
SHIP_BASE=demo/base
SHIP_LABEL=ship
MARKETPLACE_DIR=~/cursor-dev/marketplace
# Never 8000. That port belongs to the preview runner.
MARKETPLACE_BACKEND_PORT=8010
# How long GMV and AOV take to climb back after a healthy deploy.
RECOVERY_MS=25000
